# Copy to .env and fill in. Never commit the real file.
#
# LoopHaven reads these only to open your own Looperman session. They are used
# to POST the login form on your behalf and are never printed or sent anywhere
# else. Without them the API still works for public MP3 previews.
LOOPERMAN_EMAIL=
LOOPERMAN_PASSWORD=

# Where the cookie jar is persisted (defaults to %APPDATA%\loophaven\session.json
# on Windows, ~/.loophaven/session.json elsewhere).
# LOOPHAVEN_SESSION_FILE=

# Base URL of the local API, used by the CLI and the MCP server.
# LOOPHAVEN_API=http://127.0.0.1:8000

# Page reads allowed per 60 s, per process (default 30). Lower it on a shared
# connection; the API answers 429 instead of hammering Looperman.
# LOOPHAVEN_RATE_LIMIT=30
